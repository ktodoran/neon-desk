# Copy to .env. Nothing here is a real credential.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Browser origins allowed to call the API, comma-separated. Empty allows none.
# Example: ALLOWED_ORIGINS=https://www.example.com,https://shop.example.com
ALLOWED_ORIGINS=
# Chat requests allowed per client address per window.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
# Set to true only behind a proxy you control, so client addresses are read
# from X-Forwarded-For.
TRUST_PROXY=false

# Matches docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/support_assistant
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# "openai" calls any OpenAI-compatible embeddings endpoint.
# "hash" is a deterministic offline embedder for local development and tests only.
EMBEDDINGS_PROVIDER=hash
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
# Only for a model whose vectors are narrower than 1536 and cannot be resized,
# which is most models run locally: set it to the model's own size.
EMBEDDINGS_DIMENSIONS=

# Chat. Leave LLM_PROVIDER empty to run without a model: ingestion, search and
# /health still work, and POST /v1/chat answers 503.
# "anthropic" uses the Messages API. "openai" uses Chat Completions and works
# with any compatible server through LLM_BASE_URL.
# LLM_MODEL has no default on purpose: name the model you intend to pay for.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_TOKENS=800
# For an OpenAI-compatible server only. "none" turns thinking off on a model
# that thinks before it answers, which most local models now do by default.
LLM_REASONING_EFFORT=

# Used in the assistant's instructions and in its "I can't answer that" reply.
COMPANY_NAME=Acme Outfitters
SUPPORT_CONTACT=support@example.com

RAG_TOP_K=5
RAG_CANDIDATES=20
RAG_MIN_SCORE=0.3
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150
