# Copy to .env. Nothing here is a real credential.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/support_assistant
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# "openai" calls any OpenAI-compatible embeddings endpoint.
# "hash" is a deterministic offline embedder for local development and tests only.
EMBEDDINGS_PROVIDER=hash
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# Chat. Leave LLM_PROVIDER empty to run without a model: ingestion, search and
# /health still work, and POST /v1/chat answers 503.
# "anthropic" uses the Messages API. "openai" uses Chat Completions and works
# with any compatible server through LLM_BASE_URL.
# LLM_MODEL has no default on purpose: name the model you intend to pay for.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_TOKENS=800

# Used in the assistant's instructions and in its "I can't answer that" reply.
COMPANY_NAME=Acme Outfitters
SUPPORT_CONTACT=support@example.com

RAG_TOP_K=5
RAG_CANDIDATES=20
RAG_MIN_SCORE=0.3
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150
